# Copy to .env (next to SKILL.md) to configure the skill. Values in the process environment take precedence.

# API key. GEMINI_SEARCH_API_KEY is used first; GEMINI_API_KEY is the fallback.
# GEMINI_SEARCH_API_KEY=

# API endpoint, including the version path. Default: https://generativelanguage.googleapis.com/v1beta
# Example for Vertex AI (Gemini Enterprise Agent Platform) with a Google Cloud API key.
# YouTube URLs are skipped on endpoints other than generativelanguage.googleapis.com.
# GEMINI_BASE_URL=https://aiplatform.googleapis.com/v1/publishers/google

# Model (default: gemini-3.8-flash).
# GEMINI_SEARCH_MODEL=gemini-3.8-flash

# Optional faster model used only for --depth quick (default: same as GEMINI_SEARCH_MODEL).
# GEMINI_SEARCH_MODEL_QUICK=

# Default depth: quick, normal, or deep (default: normal).
# GEMINI_SEARCH_DEPTH=normal
